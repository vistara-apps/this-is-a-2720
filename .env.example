# SampleSync Environment Variables
# Copy this file to .env and fill in your actual API keys

# OpenAI API for audio analysis and AI assistance
VITE_OPENAI_API_KEY=your_openai_api_key_here

# Alchemy API for Base blockchain interactions
VITE_ALCHEMY_API_KEY=your_alchemy_api_key_here

# Supabase for database and backend services
VITE_SUPABASE_URL=your_supabase_project_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Pinata for IPFS storage
VITE_PINATA_API_KEY=your_pinata_api_key_here
VITE_PINATA_SECRET_KEY=your_pinata_secret_key_here

# Airstack for on-chain data queries
VITE_AIRSTACK_API_KEY=your_airstack_api_key_here

# WalletConnect Project ID (for wallet connections)
VITE_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id_here

# Stripe for fiat payments (optional)
VITE_STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key_here

# Base network configuration
VITE_BASE_CHAIN_ID=8453
VITE_BASE_RPC_URL=https://mainnet.base.org

# Application configuration
VITE_APP_NAME=SampleSync
VITE_APP_URL=https://samplesync.app
VITE_APP_DESCRIPTION="Clear Sample Licenses. Create Freely."

# Development settings
VITE_ENABLE_MOCK_DATA=true
VITE_DEBUG_MODE=false
